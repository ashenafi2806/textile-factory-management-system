generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String          @id @default(uuid())
  username           String          @unique
  email              String          @unique
  password           String
  roles              Role[]          @relation("UserRoles")
  workerProfile      WorkerProfile?
  recordedAttendances Attendance[]   @relation("AttendanceRecorder")
  approvedLeaves     LeaveRequest[]  @relation("LeaveApprover")
  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformedBy")
  productionRecords    ProductionOutput[] @relation("ProductionRecorder")
  reportedMaintenanceTasks MaintenanceTask[] @relation("ReportedMaintenanceTasks")
  failureReports     FailureReport[] @relation("FailureReporter")
  isVerified         Boolean         @default(false)
  verificationToken  String?
  mustChangePassword Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

enum RoleType {
  ADMIN
  HR_ADMIN
  MANAGER
  SUPERVISOR
  WORKER
  STOREKEEPER
  PRODUCTION_MANAGER
  PRODUCTION_SUPERVISOR
  MAINTENANCE_MANAGER
  MAINTENANCE_TECHNICIAN
  QA_MANAGER
  QA_STAFF
}

model Role {
  id    String   @id @default(uuid())
  name  RoleType @unique
  users User[]   @relation("UserRoles")
}

model Department {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  teams       Team[]
  workers     WorkerProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Team {
  id           String          @id @default(uuid())
  name         String
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  workers      WorkerProfile[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model WorkerProfile {
  id              String         @id @default(uuid())
  employeeId      String         @unique
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  teamId          String?
  team            Team?          @relation(fields: [teamId], references: [id])
  position        String
  salary          Float?
  phoneNumber     String?
  skillLevel      String? // Junior, Intermediate, Expert
  emergencyContact String?
  joiningDate     DateTime       @default(now())
  rotationPattern String? // JSON string e.g. '["Morning", "Night", "Off"]'
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  assignedStages  ProductionStage[]
  assignedMaintenanceTasks MaintenanceTask[] @relation("AssignedMaintenanceTasks")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum InventoryCategory {
  RAW_MATERIAL
  SPARE_PART
  ACCESSORY
  FINISHED_GOOD
}

model InventoryItem {
  id           String              @id @default(uuid())
  name         String
  sku          String              @unique
  category     InventoryCategory
  quantity     Float               @default(0)
  unit         String // meters, kg, pcs
  minThreshold Float               @default(10)
  supplier     String?
  location     String? // e.g. Warehouse A, Bin 12
  transactions InventoryTransaction[]
  spareParts   MaintenanceSparePart[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum TransactionType {
  RESTOCK // Incoming
  ISSUE // Outgoing to production/maintenance
  ADJUSTMENT // Manual correction
  RETURN // From production back to store
}

model InventoryTransaction {
  id              String        @id @default(uuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  type            TransactionType
  quantity        Float
  performedById   String
  performedBy     User          @relation("InventoryPerformedBy", fields: [performedById], references: [id])
  referenceId     String? // Optional: Link to ProductionOrder or MaintenanceTask
  note            String?
  createdAt       DateTime      @default(now())
}

model Shift {
  id        String   @id @default(uuid())
  name      String   @unique // Morning, Night, Rotation
  startTime String // "06:00"
  endTime   String // "14:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id           String        @id @default(uuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id])
  date         DateTime
  checkIn      DateTime
  checkOut     DateTime?
  recordedById String
  recordedBy   User          @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id           String            @id @default(uuid())
  orderNumber  String            @unique
  productName  String
  quantity     Int
  deadline     DateTime
  status       OrderStatus       @default(PENDING)
  priority     String?           @default("NORMAL")
  stages       ProductionStage[]
  failureReports FailureReport[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenancePriority {
  NORMAL
  CRITICAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceTask {
  id              String              @id @default(uuid())
  type            MaintenanceType
  priority        MaintenancePriority @default(NORMAL)
  status          MaintenanceStatus   @default(OPEN)
  equipmentName   String
  description     String
  scheduledDate   DateTime?
  assignedToId    String?
  assignedTo      WorkerProfile?      @relation("AssignedMaintenanceTasks", fields: [assignedToId], references: [id])
  reportedById    String
  reportedBy      User                @relation("ReportedMaintenanceTasks", fields: [reportedById], references: [id])
  completedAt     DateTime?
  timeSpentMins   Int?
  notes           String?
  spareParts      MaintenanceSparePart[]
  failureReport   FailureReport?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("maintenance_tasks")
}

model MaintenanceSparePart {
  id            String          @id @default(uuid())
  taskId        String
  task          MaintenanceTask @relation(fields: [taskId], references: [id])
  itemId        String
  item          InventoryItem   @relation(fields: [itemId], references: [id])
  quantityUsed  Float
  createdAt     DateTime        @default(now())

  @@map("maintenance_spare_parts")
}

model FailureReport {
  id                String              @id @default(uuid())
  taskId            String              @unique
  task              MaintenanceTask     @relation(fields: [taskId], references: [id])
  equipmentName     String
  description       String
  priority          MaintenancePriority @default(NORMAL)
  productionOrderId String?
  productionOrder   ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  reportedById      String
  reportedBy        User                @relation("FailureReporter", fields: [reportedById], references: [id])
  createdAt         DateTime            @default(now())

  @@map("failure_reports")
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model ProductionStage {
  id                String             @id @default(uuid())
  orderId           String
  order             ProductionOrder    @relation(fields: [orderId], references: [id])
  name              String
  sequence          Int
  status            StageStatus        @default(NOT_STARTED)
  assignedWorkerId  String?
  assignedWorker    WorkerProfile?     @relation(fields: [assignedWorkerId], references: [id])
  outputs           ProductionOutput[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ProductionOutput {
  id              String          @id @default(uuid())
  stageId         String
  stage           ProductionStage @relation(fields: [stageId], references: [id])
  quantity        Int
  defectCount     Int             @default(0)
  recordedById    String
  recordedBy      User            @relation("ProductionRecorder", fields: [recordedById], references: [id])
  notes           String?
  createdAt       DateTime        @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id           String        @id @default(uuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id])
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       LeaveStatus   @default(PENDING)
  approvedById String?
  approvedBy   User?         @relation("LeaveApprover", fields: [approvedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}