generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String

  roles         Role[]         @relation("UserRoles")
  workerProfile WorkerProfile?

  recordedAttendances Attendance[]   @relation("AttendanceRecorder")
  approvedLeaves      LeaveRequest[] @relation("LeaveApprover")

  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformedBy")
  inventoryRequisitionsRequested InventoryRequisition[] @relation("InventoryRequisitionRequestedBy")
  inventoryRequisitionsApproved  InventoryRequisition[] @relation("ApprovedRequisitions")
  inventoryReceiptsCreated InventoryReceipt[] @relation("InventoryReceiptsCreatedBy")

  createdProductionOrders    ProductionOrder[] @relation("ProductionOrdersCreatedByManager")
  supervisedProductionOrders ProductionOrder[] @relation("ProductionOrdersAssignedSupervisor")

  releaseRequestsRaised    ProductionOrder[] @relation("ProductionOrderReleaseRequestedBy")
  releaseRequestsApproved  ProductionOrder[] @relation("ProductionOrderReleaseApprovedBy")

  productionOutputs ProductionOutput[] @relation("ProductionOutputSupervisor")
  productionIssues  ProductionIssue[]  @relation("ProductionIssueReporter")

  qualityThresholds  QualityThreshold[]
  qualityInspections QualityInspection[] @relation("QualityInspectionInspector")

  completedStages ProductionStage[] @relation("ProductionStageCompletedBy")
  reviewedStages  ProductionStage[] @relation("ProductionStageReviewedBy")

  incidentsReported Incident[] @relation("IncidentReportedBy")
  incidentsApproved Incident[] @relation("IncidentApprovedBy")

  disciplinaryIssued       DisciplinaryAction[] @relation("DisciplinaryIssuedBy")
  disciplinaryAcknowledged DisciplinaryAction[] @relation("DisciplinaryAcknowledgedBy")

  createdShiftAssignments ShiftAssignment[]

  reportedMaintenanceTasks MaintenanceTask[] @relation("ReportedMaintenanceTasks")
  failureReports           FailureReport[]   @relation("FailureReporter")
  notifications             Notification[]    @relation("UserNotifications")

  isVerified         Boolean @default(false)
  verificationToken  String?
  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  overtimeCreated OvertimeRequest[] @relation("OvertimeCreatedBy")
  overtimeApproved OvertimeRequest[] @relation("OvertimeApprovedBy")
  hiringRequested HiringRequisition[] @relation("HiringRequestedBy")
  hiringApproved HiringRequisition[] @relation("HiringApprovedBy")
  // Attendance policies this user created
  createdAttendancePolicies AttendancePolicy[] @relation("AttendancePolicyCreatedBy")
}

enum RoleType {
  ADMIN
  HR_ADMIN
  MANAGER
  SUPERVISOR
  WORKER
  STOREKEEPER
  PRODUCTION_MANAGER
  PRODUCTION_SUPERVISOR
  MAINTENANCE_MANAGER
  MAINTENANCE_TECHNICIAN
  QA_MANAGER
  QA_STAFF
}

model Role {
  id    String   @id @default(uuid())
  name  RoleType @unique
  users User[]   @relation("UserRoles")
}



model WorkerProfile {
  id         String @id @default(uuid())
  employeeId String @unique

  fullName String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  department String?

  position         String
  salary           Float?
  phoneNumber      String?
  skillLevel       String?
  emergencyContact String?

  joiningDate     DateTime @default(now())
  rotationPattern String?

  attendances   Attendance[]
  leaveRequests LeaveRequest[]

  assignedStages ProductionStage[] @relation("ProductionStageAssignedWorker")

  incidents Incident[]

  disciplinaryActions DisciplinaryAction[]

  assignedMaintenanceTasks MaintenanceTask[] @relation("AssignedMaintenanceTasks")

  shiftAssignments ShiftAssignment[]
  overtimeRequests OvertimeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InventoryCategory {
  RAW_MATERIAL
  SPARE_PART
  ACCESSORY
  FINISHED_GOOD
}

model InventoryItem {
  id   String @id @default(uuid())
  name String
  sku  String @unique

  category InventoryCategory

  quantity Float  @default(0)
  unit     String

  minThreshold Float @default(10)

  supplier String?
  location String?

  transactions InventoryTransaction[]
  requisitions InventoryRequisition[]
  receiptItems InventoryReceiptItem[]

  spareParts MaintenanceSparePart[]

  bomItems BOMItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  RESTOCK
  ISSUE
  ADJUSTMENT
  RETURN
}

enum ReferenceType {
  RECEIPT
  REQUISITION
  PRODUCTION_ORDER
  MAINTENANCE_TASK
  OTHER
}

model InventoryTransaction {
  id String @id @default(uuid())

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  type TransactionType

  quantity Float

  performedById String
  performedBy   User   @relation("InventoryPerformedBy", fields: [performedById], references: [id])

  referenceId String?
  referenceType ReferenceType?
  note        String?

  createdAt DateTime @default(now())
}

model InventoryReceipt {
  id String @id @default(uuid())

  supplierName String
  batchNumber  String?
  purchaseDate DateTime

  createdById String
  createdBy   User @relation("InventoryReceiptsCreatedBy", fields: [createdById], references: [id])

  items InventoryReceiptItem[]

  createdAt DateTime @default(now())
}

model InventoryReceiptItem {
  id String @id @default(uuid())

  receiptId String
  receipt   InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  quantity Float
  unitPrice Float?

  createdAt DateTime @default(now())
}

enum RequisitionStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
}

model InventoryRequisition {
  id                String             @id @default(cuid())
  requestedById     String
  requestedBy       User               @relation("InventoryRequisitionRequestedBy", fields: [requestedById], references: [id])
  itemId            String
  item              InventoryItem      @relation(fields: [itemId], references: [id])
  quantityRequested Int
  purpose           String
  referenceId      String?
  status           RequisitionStatus  @default(PENDING)
  approvedById     String?
  approvedBy       User?              @relation("ApprovedRequisitions", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime           @default(now())
}

model TrainingMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String
  createdAt   DateTime @default(now())
}

model Shift {
  id   String @id @default(uuid())
  name String @unique

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id String @id @default(uuid())

  shiftId String
  shift   Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  // Date for which this assignment applies (date-only semantics)
  date DateTime

  createdById String?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([shiftId, workerId, date])
}

model Attendance {
  id String @id @default(uuid())

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  date     DateTime
  checkIn  DateTime
  checkOut DateTime?

  // Policy-derived fields (computed when recording attendance)
  isLate       Boolean @default(false)
  lateMinutes  Int?
  isEarlyLeave Boolean @default(false)
  earlyMinutes Int?

  policyId String?
  policy   AttendancePolicy? @relation("PolicyAttendances", fields: [policyId], references: [id])

  recordedById String
  recordedBy   User   @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendancePolicy {
  id        String   @id @default(uuid())
  name      String   @unique
  // times are stored as HH:MM (24-hour) local time strings, interpreted relative to the attendance date
  workdayStart         String?  // e.g. "08:00"
  workdayEnd           String?  // e.g. "17:00"
  gracePeriodMinutes   Int      @default(0)
  lateThresholdMinutes Int      @default(0)
  earlyLeaveThresholdMinutes Int @default(0)
  overtimeEligible     Boolean  @default(true)

  // Optional department scoping
  department String?

  // Back-relation to attendance records using this policy
  attendances Attendance[] @relation("PolicyAttendances")

  createdById String?
  createdBy   User? @relation("AttendancePolicyCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  STOPPED
  CANCELLED
}

enum ProductionReleaseRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ProductionStageName {
  CUTTING
  SEWING
  FINISHING
  PACKING
}

enum ProductionStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  QA_PENDING
  QA_APPROVED
  QA_REJECTED
}

enum ProductionIssueType {
  MACHINE_FAILURE
  MATERIAL_SHORTAGE
  QUALITY_DEFECT
  OTHER
}

enum ProductionIssuePriority {
  NORMAL
  CRITICAL
}

enum ProductionIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model ProductionOrder {
  id String @id @default(uuid())

  orderNumber String @unique

  productName String
  productCode String

  targetQuantity Int

  deadline DateTime

  status ProductionOrderStatus @default(PLANNED)

  releaseRequestStatus ProductionReleaseRequestStatus @default(NONE)

  releaseRequestedById String?

  releaseRequestedBy User? @relation("ProductionOrderReleaseRequestedBy", fields: [releaseRequestedById], references: [id])

  releaseRequestedAt DateTime?

  releaseApprovedById String?

  releaseApprovedBy User? @relation("ProductionOrderReleaseApprovedBy", fields: [releaseApprovedById], references: [id])

  releaseApprovedAt DateTime?

  releaseRejectionReason String?

  assignedSupervisorId String?

  assignedSupervisor User? @relation("ProductionOrdersAssignedSupervisor", fields: [assignedSupervisorId], references: [id])

  createdByManagerId String

  createdByManager User @relation("ProductionOrdersCreatedByManager", fields: [createdByManagerId], references: [id])

  currentStage String?

  bomItems BOMItem[]

  stages ProductionStage[]

  outputs ProductionOutput[]

  issues ProductionIssue[]

  qualityInspections QualityInspection[]

  failureReports FailureReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BOMItem {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  materialId String
  material   InventoryItem @relation(fields: [materialId], references: [id])

  requiredQuantity Float

  unit String
}

model ProductionStage {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  stageName ProductionStageName

  stageOrder Int

  status ProductionStageStatus @default(PENDING)

  assignedWorkerId String?
  assignedWorker   WorkerProfile? @relation("ProductionStageAssignedWorker", fields: [assignedWorkerId], references: [id])

  completedById String?
  completedBy   User?   @relation("ProductionStageCompletedBy", fields: [completedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ProductionStageReviewedBy", fields: [reviewedById], references: [id])

  reviewedAt DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  outputs ProductionOutput[]

  issues ProductionIssue[]

  qualityInspections QualityInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionOutput {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  stageId String
  stage   ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  supervisorId String
  supervisor   User   @relation("ProductionOutputSupervisor", fields: [supervisorId], references: [id])

  shiftDate DateTime

  goodQuantity Int

  defectiveQuantity Int @default(0)

  notes String?

  createdAt DateTime @default(now())
}

model ProductionIssue {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  stageId String?
  stage   ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  reportedById String
  reportedBy   User   @relation("ProductionIssueReporter", fields: [reportedById], references: [id])

  issueType ProductionIssueType

  description String

  priority ProductionIssuePriority @default(NORMAL)

  status ProductionIssueStatus @default(OPEN)

  createdAt DateTime @default(now())
}

model QualityThreshold {
  id String @id @default(uuid())

  stageName ProductionStageName @unique

  maxDefectsPerHundred Int

  acceptanceCriteria String

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QualityInspection {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  stageId String
  stage   ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  inspectedById String
  inspectedBy   User   @relation("QualityInspectionInspector", fields: [inspectedById], references: [id], onDelete: Cascade)

  measurements String?

  defects Int @default(0)

  result String

  notes String?

  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenancePriority {
  NORMAL
  CRITICAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceTask {
  id String @id @default(uuid())

  type MaintenanceType

  priority MaintenancePriority @default(NORMAL)

  status MaintenanceStatus @default(OPEN)

  equipmentName String

  description String

  scheduledDate DateTime?

  assignedToId String?
  assignedTo   WorkerProfile? @relation("AssignedMaintenanceTasks", fields: [assignedToId], references: [id])

  reportedById String
  reportedBy   User   @relation("ReportedMaintenanceTasks", fields: [reportedById], references: [id])

  completedAt DateTime?

  timeSpentMins Int?

  notes String?

  spareParts MaintenanceSparePart[]

  failureReport FailureReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_tasks")
}

model MaintenanceSparePart {
  id String @id @default(uuid())

  taskId String
  task   MaintenanceTask @relation(fields: [taskId], references: [id])

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  quantityUsed Float

  createdAt DateTime @default(now())

  @@map("maintenance_spare_parts")
}

model FailureReport {
  id String @id @default(uuid())

  taskId String          @unique
  task   MaintenanceTask @relation(fields: [taskId], references: [id])

  equipmentName String

  description String

  priority MaintenancePriority @default(NORMAL)

  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  reportedById String
  reportedBy   User   @relation("FailureReporter", fields: [reportedById], references: [id])

  createdAt DateTime @default(now())

  @@map("failure_reports")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  title     String
  message   String
  type      String
  urgent    Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id String @id @default(uuid())

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  startDate DateTime
  endDate   DateTime

  reason String

  status LeaveStatus @default(PENDING)

  approvedById String?
  approvedBy   User?   @relation("LeaveApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Incident {
  id String @id @default(uuid())

  title String

  description String?

  severity IncidentSeverity @default(LOW)

  workerId String?
  worker   WorkerProfile? @relation(fields: [workerId], references: [id])

  reportedById String
  reportedBy   User   @relation("IncidentReportedBy", fields: [reportedById], references: [id])

  status IncidentStatus @default(OPEN)

  approvedById String?
  approvedBy   User?   @relation("IncidentApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

model OvertimeRequest {
  id String @id @default(uuid())

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  hours Float
  reason String?
  status OvertimeStatus @default(PENDING)

  createdById String?
  createdBy   User? @relation("OvertimeCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User? @relation("OvertimeApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
}

enum HiringStatus {
  OPEN
  APPROVED
  REJECTED
}

model HiringRequisition {
  id String @id @default(uuid())

  role String
  headcount Int
  notes String?
  department String?
  requiredBy DateTime?

  status HiringStatus @default(OPEN)

  requestedById String?
  requestedBy   User? @relation("HiringRequestedBy", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User? @relation("HiringApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
}

enum DisciplinaryCategory {
  VERBAL_WARNING
  WRITTEN_WARNING
  SUSPENSION
  FINAL_WARNING
  TERMINATION
  COUNSELING
}

enum DisciplinaryStatus {
  ISSUED
  ACKNOWLEDGED
  APPEALED
  EXPIRED
  REVOKED
}

model DisciplinaryAction {
  id String @id @default(uuid())

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  category DisciplinaryCategory
  severity IncidentSeverity     @default(LOW)
  subject  String
  reason   String?
  notes    String?

  status DisciplinaryStatus @default(ISSUED)

  issuedById String
  issuedBy   User   @relation("DisciplinaryIssuedBy", fields: [issuedById], references: [id])

  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?   @relation("DisciplinaryAcknowledgedBy", fields: [acknowledgedById], references: [id])

  effectiveDate DateTime  @default(now())
  expiresAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
