generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String          @id @default(uuid())
  username           String          @unique
  email              String          @unique
  password           String
  roles              Role[]          @relation("UserRoles")
  workerProfile      WorkerProfile?
  recordedAttendances Attendance[]   @relation("AttendanceRecorder")
  approvedLeaves     LeaveRequest[]  @relation("LeaveApprover")
  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformedBy")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrdersCreatedByManager")
  supervisedProductionOrders ProductionOrder[] @relation("ProductionOrdersAssignedSupervisor")
  productionOutputs   ProductionOutput[] @relation("ProductionOutputSupervisor")
  productionIssues    ProductionIssue[] @relation("ProductionIssueReporter")
  completedStages     ProductionStage[]  @relation("ProductionStageCompletedBy")
  reviewedStages      ProductionStage[]  @relation("ProductionStageReviewedBy")
  isVerified         Boolean         @default(false)
  verificationToken  String?
  mustChangePassword Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

enum RoleType {
  ADMIN
  HR_ADMIN
  MANAGER
  SUPERVISOR
  WORKER
  STOREKEEPER
  PRODUCTION_MANAGER
  PRODUCTION_SUPERVISOR
  MAINTENANCE_MANAGER
  MAINTENANCE_TECHNICIAN
  QA_MANAGER
  QA_STAFF
}

model Role {
  id    String   @id @default(uuid())
  name  RoleType @unique
  users User[]   @relation("UserRoles")
}

model Department {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  teams       Team[]
  workers     WorkerProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Team {
  id           String          @id @default(uuid())
  name         String
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  workers      WorkerProfile[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model WorkerProfile {
  id              String         @id @default(uuid())
  employeeId      String         @unique
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  teamId          String?
  team            Team?          @relation(fields: [teamId], references: [id])
  position        String
  salary          Float?
  phoneNumber     String?
  skillLevel      String? // Junior, Intermediate, Expert
  emergencyContact String?
  joiningDate     DateTime       @default(now())
  rotationPattern String? // JSON string e.g. '["Morning", "Night", "Off"]'
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  assignedStages  ProductionStage[] @relation("ProductionStageAssignedWorker")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum InventoryCategory {
  RAW_MATERIAL
  SPARE_PART
  ACCESSORY
  FINISHED_GOOD
}

model InventoryItem {
  id           String              @id @default(uuid())
  name         String
  sku          String              @unique
  category     InventoryCategory
  quantity     Float               @default(0)
  unit         String // meters, kg, pcs
  minThreshold Float               @default(10)
  supplier     String?
  location     String? // e.g. Warehouse A, Bin 12
  transactions InventoryTransaction[]
  bomItems     BOMItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum TransactionType {
  RESTOCK // Incoming
  ISSUE // Outgoing to production/maintenance
  ADJUSTMENT // Manual correction
  RETURN // From production back to store
}

model InventoryTransaction {
  id              String        @id @default(uuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  type            TransactionType
  quantity        Float
  performedById   String
  performedBy     User          @relation("InventoryPerformedBy", fields: [performedById], references: [id])
  referenceId     String? // Optional: Link to ProductionOrder or MaintenanceTask
  note            String?
  createdAt       DateTime      @default(now())
}

model Shift {
  id        String   @id @default(uuid())
  name      String   @unique // Morning, Night, Rotation
  startTime String // "06:00"
  endTime   String // "14:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id           String        @id @default(uuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id])
  date         DateTime
  checkIn      DateTime
  checkOut     DateTime?
  recordedById String
  recordedBy   User          @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  STOPPED
  CANCELLED
}

enum ProductionStageName {
  CUTTING
  SEWING
  FINISHING
  PACKING
}

enum ProductionStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  QA_PENDING
  QA_APPROVED
  QA_REJECTED
}

enum ProductionIssueType {
  MACHINE_FAILURE
  MATERIAL_SHORTAGE
  QUALITY_DEFECT
  OTHER
}

enum ProductionIssuePriority {

  NORMAL
  CRITICAL
}

enum ProductionIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model ProductionOrder {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  productName        String
  productCode        String
  targetQuantity     Int
  deadline           DateTime
  status             ProductionOrderStatus @default(PLANNED)
  assignedSupervisorId String?
  assignedSupervisor User?               @relation("ProductionOrdersAssignedSupervisor", fields: [assignedSupervisorId], references: [id])
  createdByManagerId String
  createdByManager   User                @relation("ProductionOrdersCreatedByManager", fields: [createdByManagerId], references: [id])
  currentStage       String?
  bomItems           BOMItem[]
  stages             ProductionStage[]
  outputs            ProductionOutput[]
  issues             ProductionIssue[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model BOMItem {
  id                 String           @id @default(uuid())
  productionOrderId   String
  productionOrder     ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  materialId         String
  material           InventoryItem     @relation(fields: [materialId], references: [id])
  requiredQuantity   Float
  unit               String
}

model ProductionStage {
  id                 String               @id @default(uuid())
  productionOrderId   String
  productionOrder     ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageName          ProductionStageName
  stageOrder         Int
  status             ProductionStageStatus @default(PENDING)
  assignedWorkerId   String?
  assignedWorker     WorkerProfile?       @relation("ProductionStageAssignedWorker", fields: [assignedWorkerId], references: [id])
  completedById      String?
  completedBy        User?                @relation("ProductionStageCompletedBy", fields: [completedById], references: [id])
  reviewedById       String?
  reviewedBy         User?                @relation("ProductionStageReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  outputs            ProductionOutput[]
  issues             ProductionIssue[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ProductionOutput {
  id                 String           @id @default(uuid())
  productionOrderId   String
  productionOrder     ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageId            String
  stage              ProductionStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  supervisorId       String
  supervisor         User             @relation("ProductionOutputSupervisor", fields: [supervisorId], references: [id])
  shiftDate          DateTime
  goodQuantity       Int
  defectiveQuantity  Int              @default(0)
  notes              String?
  createdAt          DateTime         @default(now())
}

model ProductionIssue {
  id                 String             @id @default(uuid())
  productionOrderId   String
  productionOrder     ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageId            String?
  stage              ProductionStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  reportedById       String
  reportedBy         User               @relation("ProductionIssueReporter", fields: [reportedById], references: [id])
  issueType          ProductionIssueType
  description        String
  priority           ProductionIssuePriority @default(NORMAL)
  status             ProductionIssueStatus @default(OPEN)
  createdAt          DateTime           @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id           String        @id @default(uuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id])
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       LeaveStatus   @default(PENDING)
  approvedById String?
  approvedBy   User?         @relation("LeaveApprover", fields: [approvedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
